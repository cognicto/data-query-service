# Simplified Sensor Data Service Configuration

# Storage Mode (local or azure)
STORAGE_MODE=azure

# Azure Data Lake Storage Gen2 Configuration
AZURE_STORAGE_ACCOUNT=archivalpipeline01
AZURE_CONTAINER_NAME=sensor-data-cold-storage
AZURE_SAS_TOKEN=sv=2024-your-complete-sas-token-here
AZURE_DATA_PREFIX=

# Local Storage Configuration (if using STORAGE_MODE=local)
LOCAL_STORAGE_PATH=/tmp/realistic_sensor_data

# DuckDB Configuration
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Query Limits
MAX_QUERY_DURATION_HOURS=168
DEFAULT_MAX_DATAPOINTS=10000