# Production Azure Configuration for archivalpipeline01
# Copy this to .env to use your production Azure storage

# ==========================================
# STORAGE CONFIGURATION
# ==========================================
STORAGE_MODE=azure

# ==========================================
# AZURE AUTHENTICATION - archivalpipeline01 
# SAS Token Method Only (Simplified)
# ==========================================

# Azure SAS token authentication (only method supported)
AZURE_BLOB_ENDPOINT=https://archivalpipeline01.blob.core.windows.net
# TODO: Replace with your complete SAS token
AZURE_SAS_TOKEN=sv=2024-YOUR-COMPLETE-SAS-TOKEN-HERE
AZURE_CONTAINER_NAME=sensor-data-cold-storage

# No prefix needed - data is at root of container
AZURE_DATA_PREFIX=

# ==========================================
# AZURE PERFORMANCE SETTINGS
# ==========================================

# Connection settings optimized for production
AZURE_CONNECTION_TIMEOUT=60
AZURE_RETRY_ATTEMPTS=5
AZURE_MAX_WORKERS=16
AZURE_CHUNK_SIZE=2097152  # 2MB chunks for better performance

# ==========================================
# QUERY ENGINE CONFIGURATION
# ==========================================

# Extended limits for production data
MAX_QUERY_DURATION_HOURS=720  # 30 days
DEFAULT_MAX_DATAPOINTS=100000
MAX_ABSOLUTE_DATAPOINTS=1000000
DEFAULT_INTERVAL_MS=1000

# Smart features enabled
ENABLE_SMART_AGGREGATION=true
QUERY_PARALLEL_WORKERS=8

# ==========================================
# DUCKDB CONFIGURATION (High Performance)
# ==========================================

# Enable DuckDB for large Azure queries
ENABLE_DUCKDB=true
DUCKDB_MEMORY_LIMIT=32GB
DUCKDB_THREADS=16
DUCKDB_MIN_DATAPOINTS_THRESHOLD=10000

# ==========================================
# CACHE CONFIGURATION
# ==========================================

# Large cache for production Azure data
CACHE_ENABLED=true
CACHE_SIZE_MB=4096  # 4GB cache
CACHE_TTL_SECONDS=7200  # 2 hour TTL
CACHE_MAX_ENTRIES=100000

# ==========================================
# MULTI-TIER STORAGE CONFIGURATION
# ==========================================

# Optimized for your data structure
RAW_TIER_MAX_HOURS=24
AGGREGATED_TIER_MAX_HOURS=168  # 7 days
HOURLY_TIER_MAX_HOURS=720      # 30 days
DAILY_TIER_THRESHOLD_HOURS=720

# ==========================================
# API CONFIGURATION
# ==========================================

# Production API settings
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=8
API_DEBUG=false
API_RATE_LIMIT=5000/minute

# ==========================================
# LOGGING CONFIGURATION
# ==========================================

# Production logging
LOG_LEVEL=INFO

# ==========================================
# DATA STRUCTURE NOTES
# ==========================================

# Your container structure:
# sensor-data-cold-storage/
# ├── aggregated/
# ├── daily/
# └── {uuid-asset-id}/
#     └── 2026/04/04/00/
#         └── sensor_files.parquet

# No AZURE_DATA_PREFIX needed since data is at container root
# Asset IDs are UUIDs (e.g., 123e4567-e89b-12d3-a456-426614174000)