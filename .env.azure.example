# Azure Blob Storage Configuration Example
# Copy this to .env and update with your actual values

# ==========================================
# STORAGE CONFIGURATION
# ==========================================
STORAGE_MODE=azure

# ==========================================
# AZURE AUTHENTICATION (SAS Token Only)
# ==========================================

# SAS Token authentication (only method supported)
AZURE_BLOB_ENDPOINT=https://yourstorageaccount.blob.core.windows.net
AZURE_SAS_TOKEN=sv=2022-11-02&ss=bfqt&srt=sco&sp=rwdlacupiytfx&se=2025-12-31T23:59:59Z&st=2024-01-01T00:00:00Z&spr=https,http&sig=YourGeneratedSignature

# ==========================================
# AZURE CONTAINER AND DIRECTORY PATHS
# ==========================================

# Container name in your storage account
AZURE_CONTAINER_NAME=sensor-data-production

# Optional: Directory prefix within container
# Examples:
#   - Empty for root: AZURE_DATA_PREFIX=
#   - Single level: AZURE_DATA_PREFIX=sensors/
#   - Multi-level: AZURE_DATA_PREFIX=environments/production/sensors/
#   - Tenant-based: AZURE_DATA_PREFIX=tenant-123/data/
AZURE_DATA_PREFIX=production/sensors/

# ==========================================
# AZURE PERFORMANCE TUNING
# ==========================================

# Connection settings
AZURE_CONNECTION_TIMEOUT=60
AZURE_RETRY_ATTEMPTS=5

# Parallel processing
AZURE_MAX_WORKERS=12

# Upload/download chunk size (1MB = 1048576)
AZURE_CHUNK_SIZE=1048576

# ==========================================
# QUERY ENGINE CONFIGURATION
# ==========================================

# Query limits
MAX_QUERY_DURATION_HOURS=168
DEFAULT_MAX_DATAPOINTS=50000
MAX_ABSOLUTE_DATAPOINTS=500000
DEFAULT_INTERVAL_MS=1000

# Smart features
ENABLE_SMART_AGGREGATION=true
QUERY_PARALLEL_WORKERS=8

# ==========================================
# DUCKDB CONFIGURATION (High Performance)
# ==========================================

# Enable DuckDB for large queries (10x performance boost)
ENABLE_DUCKDB=true
DUCKDB_MEMORY_LIMIT=16GB
DUCKDB_THREADS=12
DUCKDB_MIN_DATAPOINTS_THRESHOLD=5000

# ==========================================
# CACHE CONFIGURATION
# ==========================================

# In-memory caching
CACHE_ENABLED=true
CACHE_SIZE_MB=2048
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=50000

# Optional: Redis backend for distributed caching
# REDIS_URL=redis://localhost:6379/0

# ==========================================
# MULTI-TIER STORAGE CONFIGURATION
# ==========================================

# Tier thresholds (hours)
RAW_TIER_MAX_HOURS=24
AGGREGATED_TIER_MAX_HOURS=168
HOURLY_TIER_MAX_HOURS=720
DAILY_TIER_THRESHOLD_HOURS=720

# ==========================================
# API CONFIGURATION
# ==========================================

# Server settings
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_DEBUG=false

# CORS settings (comma-separated origins)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting
API_RATE_LIMIT=1000/minute

# ==========================================
# LOGGING CONFIGURATION
# ==========================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==========================================
# EXAMPLES OF DIFFERENT SETUPS
# ==========================================

# Example 1: Single environment, root of container
# AZURE_CONTAINER_NAME=sensor-data
# AZURE_DATA_PREFIX=

# Example 2: Production environment with prefix  
# AZURE_CONTAINER_NAME=company-storage
# AZURE_DATA_PREFIX=sensor-data/production/

# Example 3: Multi-tenant setup
# AZURE_CONTAINER_NAME=multi-tenant-data
# AZURE_DATA_PREFIX=tenant-${TENANT_ID}/sensors/

# Example 4: Geographic separation
# AZURE_CONTAINER_NAME=global-sensors
# AZURE_DATA_PREFIX=regions/us-west/facilities/plant-1/